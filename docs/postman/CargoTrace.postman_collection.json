{
  "info": {
    "name": "CargoTrace API",
    "description": "Postman collection untuk CargoTrace REST API (Laravel Sanctum).\n\n1. Jalankan 'Auth > Login' lebih dulu; token disimpan otomatis ke variabel {{token}}.\n2. Isi variabel carrier_id, origin_id, destination_id, customer_id sesuai data di database kamu.\n3. Nilai contoh di body (nama lokasi, koordinat) hanya placeholder: ganti dengan data nyata.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "shipment_id",
      "value": ""
    },
    {
      "key": "exception_id",
      "value": ""
    },
    {
      "key": "carrier_id",
      "value": ""
    },
    {
      "key": "origin_id",
      "value": ""
    },
    {
      "key": "destination_id",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": ""
    },
    {
      "key": "departure",
      "value": ""
    },
    {
      "key": "arrival",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nama Kamu\",\n  \"email\": \"email@contoh.test\",\n  \"password\": \"min-8-karakter\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }",
                  "pm.test('status is 2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@cargotrace.test\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Akun seeder lokal. Ganti password di server online."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }",
                  "pm.test('status is 2xx', () => pm.response.to.be.success);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "logout"
              ]
            }
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/user",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Shipments",
      "item": [
        {
          "name": "List shipments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments?status=IN_TRANSIT&delayed=1&q=SHP&sort=created_at&direction=desc&per_page=15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "IN_TRANSIT"
                },
                {
                  "key": "delayed",
                  "value": "1"
                },
                {
                  "key": "q",
                  "value": "SHP"
                },
                {
                  "key": "sort",
                  "value": "created_at"
                },
                {
                  "key": "direction",
                  "value": "desc"
                },
                {
                  "key": "per_page",
                  "value": "15"
                }
              ]
            }
          }
        },
        {
          "name": "Create shipment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"carrier_id\": \"{{carrier_id}}\",\n  \"origin_id\": \"{{origin_id}}\",\n  \"destination_id\": \"{{destination_id}}\",\n  \"cargo_type\": \"General cargo\",\n  \"weight_kg\": 100,\n  \"volume_cbm\": 1.5,\n  \"freight_cost\": 500,\n  \"currency_code\": \"USD\",\n  \"exchange_rate\": 16000,\n  \"expected_departure_at\": \"{{departure}}\",\n  \"expected_arrival_at\": \"{{arrival}}\",\n  \"items\": [\n    {\n      \"description\": \"Box\",\n      \"quantity\": 2,\n      \"weight_kg\": 50\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const d = (n) => new Date(Date.now() + n * 86400000).toISOString().slice(0, 19).replace('T', ' ');",
                  "pm.collectionVariables.set('departure', d(1));",
                  "pm.collectionVariables.set('arrival', d(7));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('shipment_id', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Show shipment",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments/{{shipment_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments",
                "{{shipment_id}}"
              ]
            }
          }
        },
